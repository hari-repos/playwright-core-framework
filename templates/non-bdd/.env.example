# Active test environment (affects which .env.<env> file is loaded, e.g. .env.qa or .env.dev)
TEST_ENV=qa

# Target URLs loaded directly by the core framework
BASE_URL=https://qa.yourcompany.com
API_URL=https://api.qa.yourcompany.com

# Authorization Token (if using static tokens)
BEARER_TOKEN=your_auth_token_here
