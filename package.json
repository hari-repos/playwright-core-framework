{
  "name": "@hari/playwright-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise-grade Playwright platform framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hari-playwright-init": "dist/bin/cli.js",
    "hari-serve-report": "dist/bin/serve-report.js",
    "hari-test-runner": "dist/bin/test-runner.js"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:templates": "playwright test tests/templates"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "allure-playwright": "^3.10.0",
    "browserstack-node-sdk": "1.52.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.0",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@allurereport/plugin-awesome": "^3.10.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.44.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "@types/yaml": "^1.9.6",
    "allure": "^3.10.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.5",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
